// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPER
}

enum PoolStatus {
  WAITING
  PLAYING
  COMPLETE
  REMOVED
}

model User {
  id             String   @id @unique @default(uuid())
  name           String
  username       String   @unique
  hashedPassword String
  refreshToken   String?  @db.VarChar(500)
  status         Boolean  @default(true)
  role           Role     @default(ADMIN)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()

  @@map("users")
}

model Customer {
  id                 String            @id @unique @default(uuid())
  name               String
  phone              String            @unique
  address            String?
  status             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt()
  PlayingHistories   PlayingHistories? @relation(fields: [playingHistoriesId], references: [id])
  playingHistoriesId String?
  queuepools         QueuePool[]

  @@map("customers")
}

model QueuePool {
  id          Int     @id @unique @default(autoincrement())
  customerId  String
  queueNumber Int
  numOfCall   Int        @default(0)
  status      PoolStatus @default(WAITING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt()
  customer    Customer?  @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("queue_pools")
}

model PlayingHistories {
  id         String     @id @unique @default(uuid())
  customerId String
  datetime   DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt()
  customers  Customer[]

  @@index([customerId, datetime])
  @@map("playing_histories")
}

model Utility {
  id           String   @id @unique @default(uuid())
  appName      String?
  logoSmall    String?
  logoFull     String?
  textColor    String?  @default("#fffff")
  bgColor      String?  @default("#000000")
  mainEmail    String?
  mainWhatsApp String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt()

  @@map("utilities")
}
