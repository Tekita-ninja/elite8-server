// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", , "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPER
}

enum PoolStatus {
  WAITING
  PLAYING
  COMPLETE
  REMOVED
}

model User {
  id             String   @id @unique @default(uuid())
  name           String
  username       String   @unique
  hashedPassword String
  refreshToken   String?  @db.VarChar(500)
  status         Boolean  @default(true)
  role           Role     @default(ADMIN)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()

  @@map("users")
}

model Customer {
  id             String                 @id @unique @default(uuid())
  name           String
  phone          String                 @unique
  address        String?
  visitHistories CustomerVisitHistory[]
  status         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt()

  @@map("customers")
}

model QueuePool {
  id          Int        @id @unique @default(autoincrement())
  phoneNumber String
  name        String
  queueNumber Int
  numOfCall   Int        @default(0)
  tableNumber String     @default("")
  numOfPax    Int        @default(0)
  status      PoolStatus @default(WAITING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt()

  // @@unique([phoneNumber, status])
  @@map("queue_pools")
}

model Utility {
  id           String   @id @unique @default(uuid())
  appName      String?
  logoSmall    String?
  logoFull     String?
  textColor    String?  @default("#fffff")
  bgColor      String?  @default("#000000")
  mainEmail    String?
  mainWhatsApp String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt()

  @@map("utilities")
}

model Banner {
  id        String   @id @unique @default(uuid())
  filename  String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@map("banners")
}

model CustomerVisitHistory {
  id         String   @id @unique @default(uuid())
  customerId String
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt()
  status     Boolean  @default(true)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_visit_histories")
}
