// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER
}

enum TemplateMessage {
  WHATSAPP
  EMAIL
}

model users {
  id             String   @id @unique @default(uuid())
  name           String
  email          String   @unique
  phone          String?  @unique @db.VarChar(16)
  hashedPassword String
  refreshToken   String?  @db.VarChar(500)
  status         Boolean  @default(true)
  role           Role     @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()
}

model categories {
  id          String   @id @unique @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String   @db.VarChar(500)
  status      Boolean  @default(true)
  sortNumber  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt()

  products products[]

  @@index([slug])
}

model productimages {
  id        String    @id @unique @default(uuid())
  productId String?
  path      String
  thumbnail  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt()
  product   products? @relation(fields: [productId], references: [id])
}

enum Discount {
  PERCENT
  NOMINAL
}

model discount {
  id        String   @id @unique @default(uuid())
  type      Discount @default(PERCENT)
  amount    Int
  productId String   @unique
  product   products @relation(fields: [productId], references: [id])
}

model products {
  id              String   @id @unique @default(uuid())
  categoryId      String
  name            String
  slug            String   @unique
  description     String   @db.Text()
  status          Boolean  @default(true)
  videos          String?
  price           Float?
  stock           Int?
  hasVarian       Boolean
  weight          Int?
  freeShiping     Boolean  @default(false)
  isPromo         Boolean? @default(false)
  percentDiscount Int?     @default(0)
  tiktokUrl       String?
  shopeeUrl       String?
  tokopediaUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt()

  images   productimages[]
  varians  varian[]
  category categories?     @relation(fields: [categoryId], references: [id])
  discount discount?

  @@index([slug, name])
}

model MessageTemplate {
  id        String          @id @unique @default(uuid())
  type      TemplateMessage
  message   String          @db.LongText
  status    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt()

  @@map("message_templates")
}

model varian {
  id        String  @id @unique @default(uuid())
  productId String
  name      String
  value     String
  price     Float?
  stock     Int?
  hasChild  Boolean

  subvarian subvarian[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt()
  product   products?   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model subvarian {
  id        String   @id @unique @default(uuid())
  varianId  String
  name      String
  value     String
  price     Float
  stock     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  varian    varian   @relation(fields: [varianId], references: [id], onDelete: Cascade)
}

model utils {
  id                String   @id @unique @default(uuid())
  appName           String?
  logoSmall         String?
  logoFull          String?
  videoProfile      String?
  mainEmail         String?
  mainWhatsApp      String?
  mainPhone         String?
  midtransPublicKey String?
  mainAddress       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt()
}

enum Contact {
  EMAIL
  PHONE
  WHATSAPP
}

model contacts {
  id        String   @id @unique @default(uuid())
  icon      String?
  name      String
  value     String
  type      Contact  @default(EMAIL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model socials {
  id        String   @id @unique @default(uuid())
  icon      String?
  name      String
  link      String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model stores {
  id        String   @id @unique @default(uuid())
  icon      String?
  name      String
  link      String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model payments {
  id        String   @id @unique @default(uuid())
  icon      String?
  name      String
  holder    String
  number    String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model couriers {
  id        String   @id @unique @default(uuid())
  icon      String?
  name      String
  value     String?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model hero {
  id        String   @id @unique @default(uuid())
  image     String
  title     String?
  subtitle  String?
  caption   String?
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}
